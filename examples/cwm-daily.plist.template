<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.cwm-daily-__SLUG__</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__HOME__/.claude/skills/mj-category-weekly-monitor/scripts/daily_run.sh</string><string>__SLUG__</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>__HOME__/.npm-global/bin:__HOME__/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StandardOutPath</key><string>__HOME__/.claude/skills/mj-category-weekly-monitor/data/__SLUG__/daily_runs/launchd.out</string>
  <key>StandardErrorPath</key><string>__HOME__/.claude/skills/mj-category-weekly-monitor/data/__SLUG__/daily_runs/launchd.err</string>
</dict>
</plist>
